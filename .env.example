# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só no servidor (Vercel). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada nos e-mails de confirmação/recuperação)
NEXT_PUBLIC_SITE_URL=https://app.nivela3d.com.br

# --- Webhook da plataforma de vendas (App Digital Hub) ---
# Invente um token longo e aleatório e use o mesmo na URL do webhook.
DIGITALHUB_WEBHOOK_TOKEN=
# Opcional: mapeia ID/nome exato do produto na plataforma → plano
# PLAN_PRODUCT_MAP={"123456":"iniciante","123457":"profissional","123458":"empresa"}
PLAN_PRODUCT_MAP={}

# --- Links de checkout dos planos ---
NEXT_PUBLIC_CHECKOUT_INICIANTE=
NEXT_PUBLIC_CHECKOUT_PROFISSIONAL=
NEXT_PUBLIC_CHECKOUT_EMPRESA=
# Opcional: trimestral e anual (o seletor só aparece quando os 3 planos do ciclo têm link)
NEXT_PUBLIC_CHECKOUT_INICIANTE_TRIMESTRAL=
NEXT_PUBLIC_CHECKOUT_PROFISSIONAL_TRIMESTRAL=
NEXT_PUBLIC_CHECKOUT_EMPRESA_TRIMESTRAL=
NEXT_PUBLIC_CHECKOUT_INICIANTE_ANUAL=
NEXT_PUBLIC_CHECKOUT_PROFISSIONAL_ANUAL=
NEXT_PUBLIC_CHECKOUT_EMPRESA_ANUAL=

# --- Clube de Ofertas 3D ---
NEXT_PUBLIC_CLUBE_WHATSAPP=
NEXT_PUBLIC_CLUBE_TELEGRAM=

# Oferta vitalícia (pagamento único) — quando Básico e Completo estão preenchidos,
# a página de vendas mostra só essas duas ofertas.
NEXT_PUBLIC_CHECKOUT_VITALICIO_BASICO=
NEXT_PUBLIC_CHECKOUT_VITALICIO_COMPLETO=
# Completo com desconto, oferecido no pop-up de quem clica no Básico
NEXT_PUBLIC_CHECKOUT_VITALICIO_UPGRADE=
